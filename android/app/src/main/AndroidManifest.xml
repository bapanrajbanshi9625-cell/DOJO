<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ==========================================================
         NETWORK
         ========================================================== -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- ==========================================================
         LOCATION
         Current location / map / live walk
         ========================================================== -->

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- ==========================================================
         FOREGROUND LOCATION
         Required when Live Walk location tracking continues
         while the app is in foreground-service mode.
         ========================================================== -->

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- ==========================================================
         CAMERA
         QR Scanner / Profile Selfie
         ========================================================== -->

    <uses-permission android:name="android.permission.CAMERA" />

    <!-- ==========================================================
         MICROPHONE
         Keep only if the app actually uses microphone/audio
         recording.
         ========================================================== -->

    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- ==========================================================
         PHONE CALL
         Required only for direct ACTION_CALL.
         ========================================================== -->

    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- ==========================================================
         NOTIFICATIONS
         Android 13+
         ========================================================== -->

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ==========================================================
         VIBRATION
         Walk request / notification alerts
         ========================================================== -->

    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- ==========================================================
         APPLICATION
         ========================================================== -->

    <application
        android:name="${applicationName}"
        android:label="Dojo Walk"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="false"
        android:allowBackup="true"
        android:supportsRtl="true">

        <!-- ======================================================
             MAIN ACTIVITY
             ====================================================== -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <!-- ==================================================
                 FLUTTER NORMAL THEME
                 ================================================== -->

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <!-- ==================================================
                 LAUNCHER
                 ================================================== -->

            <intent-filter>

                <action
                    android:name="android.intent.action.MAIN" />

                <category
                    android:name="android.intent.category.LAUNCHER" />

            </intent-filter>

        </activity>

        <!-- ======================================================
             FLUTTER ENGINE
             ====================================================== -->

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

    </application>

</manifest>
